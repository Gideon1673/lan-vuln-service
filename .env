# RabbitMQ
RABBITMQ_URL=amqp://admin:123456@rabbitmq.thong.stream:5672/%2F

# Exchange
RABBITMQ_EXCHANGE=lan_scanner
RABBITMQ_EXCHANGE_TYPE=topic

# Consumer
RABBITMQ_QUEUE=assessment.inbox
RABBITMQ_REQUEST_BINDING="platform.assessment.#"
RABBITMQ_CANCEL_BINDING=platform.scan.cancelled

# Publisher
RABBITMQ_COMPLETED_STEP_KEY=assessment.step.completed
RABBITMQ_COMPLETED_STAGE_KEY=assessment.stage.completed

# Supported Event Types
RABBITMQ_LIST_EVENT_TYPE=platform.assessment.stage.requested,platform.scan.cancelled

# Dead Letter
RABBITMQ_DLX=vulnerability.assessment.dlx
RABBITMQ_DLQ=vulnerability.assessment.dead.v2

# PostgreSQL
DATABASE_URL=postgresql+psycopg://scanner:scanner@postgres.thong.stream:5432/vuln
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

DB_ECHO=false

# Scope Service
SCOPE_CHECK_URL=http://localhost:8000/scope/check

# NVD
NVD_API_KEY=
NVD_CACHE_HOURS=24
NVD_REQUEST_INTERVAL=7

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=8082